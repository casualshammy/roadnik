<Project Sdk="Microsoft.NET.Sdk.Web">

		<PropertyGroup>
				<OutputType>Exe</OutputType>
				<TargetFramework>net10.0</TargetFramework>
				<ImplicitUsings>enable</ImplicitUsings>
				<Nullable>enable</Nullable>
				<ApplicationIcon>favicon.ico</ApplicationIcon>
				<LangVersion>latest</LangVersion>
				<PublishAot>true</PublishAot>
				<AssemblyName>roadnik-server</AssemblyName>
				<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
				<!-- ILC crashes with InvalidCastException in CompileMultiThreaded when cross-compiling arm64 via QEMU.
				     IlcMaxParallelism controls code-gen threads (--maxGenCodeThreads); IlcExtraArgs --parallelism
				     controls ILScanner threads — both must be 1 to fully disable multi-threading in ILC. -->
				<IlcMaxParallelism>1</IlcMaxParallelism>
				<IlcExtraArgs>--parallelism 1</IlcExtraArgs>
		</PropertyGroup>

		<ItemGroup>
				<Content Include="favicon.ico" />
		</ItemGroup>

		<ItemGroup>
				<PackageReference Include="Ax.Fw.App" Version="15.0.295" />
				<PackageReference Include="Ax.Fw.Log" Version="15.0.295" />
				<PackageReference Include="Ax.Fw.Web" Version="15.0.295" />
				<PackageReference Include="System.Linq.Async" Version="7.0.1" />
		</ItemGroup>

		<ItemGroup>
				<ProjectReference Include="..\common\Roadnik.Common.csproj" />
		</ItemGroup>

</Project>
