<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roadnik.MAUI.Controls.OptionsTextValue">

    <Grid
        ColumnDefinitions="*, Auto"
        RowDefinitions="*">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer x:Name="TapCommandHandler" />
        </Grid.GestureRecognizers>
        <VerticalStackLayout 
            Grid.Column="0"
            VerticalOptions="Center"
            Margin="20, 0, 5, 0"
            MinimumWidthRequest="100">
            <Label 
                x:Name="TitleLabel"
                FontSize="15"/>
            <Label
                x:Name="DetailsTextLabel"
                IsVisible="False"
                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                FontSize="14"/>
        </VerticalStackLayout>
        <Border
            x:Name="ValueBorder"
            Grid.Column="1"
            HorizontalOptions="End"
            VerticalOptions="Center"
            Margin="5, 5, 20, 5"
            MinimumWidthRequest="60"
            MaximumWidthRequest="160"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="0"
            Stroke="Transparent"
            BackgroundColor="{StaticResource Primary}"
            Padding="10, 5, 10, 5">
            
            <Label
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                TextColor="White"
                LineBreakMode="TailTruncation"
                MaxLines="1"
                x:Name="ValueTextLabel" />
        </Border>
        <Label
            x:Name="RightEmojiLabel"
            Grid.Column="1"
            IsVisible="False"
            FontSize="22"
            HorizontalOptions="End"
            VerticalOptions="Center"
            Margin="5, 0, 20, 0"/>

    </Grid>

</ContentView>
